                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Cookies are still cleared even without a refresh cookie', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    pm.expect(cookies.some(c => c.includes('LINK_SESSION') && c.includes('Max-Age=0'))).to.be.true;",
                  "    pm.expect(cookies.some(c => c.includes('LINK_REFRESH') && c.includes('Max-Age=0'))).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout without a refresh cookie — e.g. the cookie has already expired. The server still clears both cookies and returns 204. No revocation happens (nothing to revoke)."
          }
        }
      ]
    },
    {
      "name": "Via Gateway",
      "description": "Smoke tests that exercise the full stack: browser → gateway (8080) → auth-service (8081).\n\nThe gateway reads the LINK_SESSION cookie, verifies the JWT, and forwards Authorization: Bearer to auth-service.\n\nRun order: Gateway Login → Gateway Me (cookie) → Gateway Logout",
      "item": [
        {
          "name": "Gateway — Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('LINK_SESSION cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie').map(h => h.value);",
                  "    pm.expect(cookies.some(c => c.includes('LINK_SESSION'))).to.be.true;",
                  "});",
                  "",
                  "pm.test('LINK_REFRESH cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie').map(h => h.value);",
                  "    pm.expect(cookies.some(c => c.includes('LINK_REFRESH'))).to.be.true;",
                  "});",
                  "",
                  "const sessionHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie').map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_SESSION='));",
                  "if (sessionHeader) {",
                  "    const jwt = sessionHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_jwt', jwt);",
                  "}",
                  "",
                  "const refreshHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie').map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_REFRESH='));",
                  "if (refreshHeader) {",
                  "    const refresh = refreshHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_refresh', refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{gateway_base_url}}/api/auth/login",
              "host": ["{{gateway_base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login through the gateway. The gateway forwards to auth-service:8081/auth/login (strips /api prefix). Signup is excluded — just needs alice to exist already."
          }
        },
        {
          "name": "Gateway — Me (via LINK_SESSION cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Body has id, email, username', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('email');",
                  "    pm.expect(body).to.have.property('username');",
                  "});",
                  "",
                  "pm.test('This proves the gateway rewrote the cookie to a Bearer token', () => {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "LINK_SESSION={{last_jwt}}",
                "description": "Simulates the browser sending the HttpOnly cookie. The gateway reads it, verifies the JWT, and forwards Authorization: Bearer to auth-service."
              }
            ],
            "url": {
              "raw": "{{gateway_base_url}}/api/auth/me",
              "host": ["{{gateway_base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "GET /api/auth/me through the gateway using the LINK_SESSION cookie.\n\nWhat happens internally:\n  1. Gateway reads LINK_SESSION cookie value (the JWT)\n  2. Verifies signature + expiry with the RSA public key\n  3. Adds Authorization: Bearer <jwt> header\n  4. Forwards to auth-service:8081/auth/me\n  5. auth-service Spring Security validates the Bearer token and returns user info\n\nIf this returns 200, the cookie→JWT→Bearer rewrite is working."
          }
        },
        {
          "name": "Gateway — Me without cookie → 401",
          "event": [
