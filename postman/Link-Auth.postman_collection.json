            "url": {
              "raw": "{{gateway_base_url}}/api/auth/logout",
              "host": ["{{gateway_base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Logout through the gateway. /api/auth/logout is a public path — the gateway skips JWT validation and forwards directly. Auth-service revokes the refresh token and clears cookies."
          }
        }
