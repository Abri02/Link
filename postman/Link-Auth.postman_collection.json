{
  "info": {
    "name": "Link — Auth Service",
    "_postman_id": "link-auth-collection-v1",
    "description": "Tests for all auth-service endpoints.\n\nTwo base URLs:\n  base_url         = http://localhost:8081  (auth-service directly, Days 1–4)\n  gateway_base_url = http://localhost:8080  (via gateway, Day 5+)\n\nPrerequisite: Postgres running via docker compose, AuthServiceApplication started in IntelliJ.\nFor gateway tests: GatewayApplication must also be running.\n\nTypical run order (direct):\n  1. Signup — happy path\n  2. Login — happy path  (saves last_jwt + last_refresh)\n  3. Me — happy path     (uses last_jwt)\n  4. Refresh — happy path (uses last_refresh, rotates tokens)\n  5. Logout — happy path  (uses last_refresh, clears cookies)\n\nFor end-to-end gateway smoke test run the 'Via Gateway' folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "gateway_base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Gateway address. All frontend traffic goes through here in production."
    },
    {
      "key": "last_jwt",
      "value": "",
      "type": "string",
      "description": "Set automatically by Login / Refresh happy-path test scripts."
    },
    {
      "key": "last_refresh",
      "value": "",
      "type": "string",
      "description": "Set automatically by Login / Refresh happy-path test scripts."
    }
  ],
  "item": [
    {
      "name": "Signup",
      "item": [
        {
          "name": "Signup — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('LINK_SESSION cookie is set', () => {",
                  "    const header = pm.response.headers.get('Set-Cookie') || '';",
                  "    pm.expect(header).to.include('LINK_SESSION');",
                  "});",
                  "",
                  "pm.test('LINK_SESSION is HttpOnly', () => {",
                  "    const header = pm.response.headers.get('Set-Cookie') || '';",
                  "    pm.expect(header).to.include('HttpOnly');",
                  "});",
                  "",
                  "pm.test('LINK_REFRESH cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const hasRefresh = cookies.some(c => c.includes('LINK_REFRESH'));",
                  "    pm.expect(hasRefresh).to.be.true;",
                  "});",
                  "",
                  "pm.test('LINK_REFRESH path is /api/auth/refresh', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const refresh = cookies.find(c => c.includes('LINK_REFRESH'));",
                  "    pm.expect(refresh).to.include('Path=/api/auth/refresh');",
                  "});",
                  "",
                  "pm.test('Response body is empty', () => {",
                  "    pm.expect(pm.response.text()).to.equal('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"alice\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            }
          }
        },
