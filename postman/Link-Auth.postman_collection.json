                  "});",
                  "",
                  "pm.test('Gateway rejects request before reaching auth-service', () => {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_base_url}}/api/auth/me",
              "host": ["{{gateway_base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "No LINK_SESSION cookie. The gateway's JwtCookieFilter rejects the request with 401 before it even reaches auth-service."
          }
        },
