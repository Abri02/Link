    {
      "name": "Login",
      "item": [
        {
          "name": "Login — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('LINK_SESSION cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const hasSession = cookies.some(c => c.includes('LINK_SESSION'));",
                  "    pm.expect(hasSession).to.be.true;",
                  "});",
                  "",
                  "pm.test('LINK_REFRESH cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const hasRefresh = cookies.some(c => c.includes('LINK_REFRESH'));",
                  "    pm.expect(hasRefresh).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response body is empty', () => {",
                  "    pm.expect(pm.response.text()).to.equal('');",
                  "});",
                  "",
                  "// Save the JWT so the Me and Refresh requests can use it.",
                  "const sessionHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie')",
                  "    .map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_SESSION='));",
                  "",
                  "if (sessionHeader) {",
                  "    const jwt = sessionHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_jwt', jwt);",
                  "    console.log('JWT saved → collection variable last_jwt');",
                  "}",
                  "",
                  "// Save the refresh token so the Refresh and Logout requests can use it.",
                  "const refreshHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie')",
                  "    .map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_REFRESH='));",
                  "",
                  "if (refreshHeader) {",
                  "    const refresh = refreshHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_refresh', refresh);",
                  "    console.log('Refresh token saved → collection variable last_refresh');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Run 'Signup — happy path' first to create the alice account.\n\nOn success, saves last_jwt and last_refresh to collection variables for use by Me, Refresh, and Logout."
          }
        },
        {
          "name": "Login — wrong password → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error message is generic (no hint about which field was wrong)', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.equal('Invalid credentials');",
                  "});",
                  "",
                  "pm.test('No Set-Cookie header on failure', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie');",
                  "    pm.expect(cookies.length).to.equal(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login — email not registered → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Same generic message as wrong password (no user enumeration)', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.equal('Invalid credentials');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Me — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Body has id, email, username', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('email');",
                  "    pm.expect(body).to.have.property('username');",
                  "});",
                  "",
                  "pm.test('id is a number', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('email matches alice', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.email).to.equal('alice@example.com');",
                  "});",
                  "",
                  "pm.test('username matches alice', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.username).to.equal('alice');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{last_jwt}}",
                "description": "Populated automatically by 'Login — happy path'."
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Run 'Login — happy path' first — it saves the JWT into last_jwt.\n\nIn production the gateway adds this header automatically from the LINK_SESSION cookie. In local dev we pass it manually."
          }
        },
        {
          "name": "Me — no token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "No Authorization header — Spring Security's resource server filter rejects the request before it reaches the controller."
          }
        },
        {
          "name": "Me — tampered token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI5OTkifQ.invalidsignature"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "A JWT with an invalid signature — the RSA signature check fails and Spring returns 401."
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "item": [
        {
          "name": "Refresh — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('New LINK_SESSION cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const hasSession = cookies.some(c => c.includes('LINK_SESSION'));",
                  "    pm.expect(hasSession).to.be.true;",
                  "});",
                  "",
                  "pm.test('New LINK_REFRESH cookie is set', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const hasRefresh = cookies.some(c => c.includes('LINK_REFRESH'));",
                  "    pm.expect(hasRefresh).to.be.true;",
                  "});",
                  "",
                  "// Rotate the saved tokens so subsequent requests use the new ones.",
                  "const sessionHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie')",
                  "    .map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_SESSION='));",
                  "",
                  "if (sessionHeader) {",
                  "    const jwt = sessionHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_jwt', jwt);",
                  "    console.log('New JWT saved → last_jwt');",
                  "}",
                  "",
                  "const refreshHeader = pm.response.headers.all()",
                  "    .filter(h => h.key === 'Set-Cookie')",
                  "    .map(h => h.value)",
                  "    .find(c => c.startsWith('LINK_REFRESH='));",
                  "",
                  "if (refreshHeader) {",
                  "    const refresh = refreshHeader.split('=')[1].split(';')[0];",
                  "    pm.collectionVariables.set('last_refresh', refresh);",
                  "    console.log('New refresh token saved → last_refresh');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "LINK_REFRESH={{last_refresh}}",
                "description": "Populated automatically by 'Login — happy path'."
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Run 'Login — happy path' first — it saves the refresh token into last_refresh.\n\nOn success, both last_jwt and last_refresh are updated with the newly issued tokens. The old refresh token is revoked (single-use / rotation)."
          }
        },
        {
          "name": "Refresh — no cookie → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error message mentions missing token', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.equal('No refresh token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Refresh — invalid token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error message mentions invalid token', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.message).to.equal('Invalid refresh token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "LINK_REFRESH=not-a-real-token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Logout",
      "item": [
        {
          "name": "Logout — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('LINK_SESSION cookie is cleared (Max-Age=0)', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const session = cookies.find(c => c.includes('LINK_SESSION'));",
                  "    pm.expect(session).to.include('Max-Age=0');",
                  "});",
                  "",
                  "pm.test('LINK_REFRESH cookie is cleared (Max-Age=0)', () => {",
                  "    const cookies = pm.response.headers.all()",
                  "        .filter(h => h.key === 'Set-Cookie')",
                  "        .map(h => h.value);",
                  "    const refresh = cookies.find(c => c.includes('LINK_REFRESH'));",
                  "    pm.expect(refresh).to.include('Max-Age=0');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "LINK_REFRESH={{last_refresh}}",
                "description": "Populated automatically by 'Login — happy path'."
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Run 'Login — happy path' first.\n\nRevokes the refresh token and returns both cookies with Max-Age=0 so the browser deletes them."
          }
        },
        {
          "name": "Logout — no cookie (still 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
